+        if mode == "overhead":
+            near = 0.0
+        self._cine_w += (1 - np.exp(-dt / 0.8)) * (near - self._cine_w)
+        w = float(self._cine_w); w = w * w * (3 - 2 * w)
+        u = min(max(t / T, 0.0), 1.0); s = u * u * (3 - 2 * u)
