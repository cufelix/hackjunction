# Finals image WITH the adaptive brain: ONE container = policy server (:8000) + llama.cpp server (127.0.0.1:8080).
# The finals runner starts exactly `docker run -d --gpus all -p PORT:8000 IMAGE` (no volumes, args, second container),
# so llama-server, Qwen3-VL-8B-Instruct Q8_0 and its mmproj live INSIDE the image and the overlay points at loopback.
# The default policy image (tools/submission.Dockerfile) stays brain-free; this file is a separate variant.
#
# Built FROM the reviewed release image (POLICY_IMAGE), so the policy layers are reused, not re-declared. This file adds
# llama-server, the model and the agent overlay. Brain stays OFF unless --build-arg BRAIN_ENABLED=1.
#
# Staged (never downloaded here) under tools/brain/ before the build, from the repo root:
#   tools/brain/llama.cpp/                          pinned llama.cpp source tree (Qwen3-VL support, CUDA 12.8, sm_120)
#   tools/brain/models/Qwen3VL-8B-Instruct-Q8_0.gguf
#   tools/brain/models/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf
#   docker build -f tools/brain/Dockerfile.policy_brain --build-arg POLICY_IMAGE=hackjunction/policy:<release-tag> \
#       --build-arg BRAIN_ENABLED=1 -t hackjunction/policy:finals-agent .
# Record the llama.cpp commit and both GGUF sha256 next to the image. Not built in this branch.
ARG POLICY_IMAGE=hackjunction/policy:latest
ARG BRAIN_ENABLED=0

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS llama
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends cmake build-essential git ca-certificates libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY tools/brain/llama.cpp /src/llama.cpp
# Any cmake, build or copy failure fails the build (no `|| true`). GGML_NATIVE=OFF: no tuning to the build host CPU.
RUN cmake -S /src/llama.cpp -B /src/build -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=120 -DGGML_NATIVE=OFF -DLLAMA_CURL=OFF \
        -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /src/build --target llama-server -j"$(nproc)" \
 && mkdir -p /out/bin /out/lib && cp /src/build/bin/llama-server /out/bin/ && cp /src/build/bin/*.so* /out/lib/

FROM ${POLICY_IMAGE} AS brain
ARG BRAIN_ENABLED
ENV BRAIN_ENABLED=${BRAIN_ENABLED}
WORKDIR /app

# cuBLAS for llama-server: the release base ships cudart only. Keep the 12.8 line matching the build stage.
RUN apt-get update && apt-get install -y --no-install-recommends libcublas-12-8 \
    && rm -rf /var/lib/apt/lists/*

# ---- brain: server + models (inside the image; no volume at finals)
COPY --from=llama /out/ /opt/brain/
COPY tools/brain/models/ /opt/brain/models/
COPY tools/brain/entrypoint.policy_brain.sh /opt/brain/entrypoint.sh

# ---- overlay: the release image bakes submission.yaml as overlay.yaml. Replace it with the agent overlay, then set the
# two brain keys from BRAIN_ENABLED (1 = on, anything else = off), and run the release checks against the result.
COPY aaltonomous/baselines/classical/overlays/finals_r22_agent.yaml aaltonomous/baselines/classical/overlay.yaml
RUN python3 -c "import os, yaml; \
p='aaltonomous/baselines/classical/overlay.yaml'; d=yaml.safe_load(open(p)); f=d['flags']; \
f['brain.enabled']=os.environ['BRAIN_ENABLED']=='1'; f['brain.url']='http://127.0.0.1:8080/completion'; \
yaml.safe_dump(d, open(p, 'w'), sort_keys=False)" \
 && python3 -c "from aaltonomous.baselines.classical.policy_server import ClassicalServerPolicy; ClassicalServerPolicy()" \
 && python3 tools/flags.py \
 && python3 -c "import os, sys; from aaltonomous.baselines.classical.config import _get, load_config; \
c=load_config(); want=os.environ['BRAIN_ENABLED']=='1'; \
sys.exit(0 if _get(c, 'brain.enabled')==want and _get(c, 'brain.url')=='http://127.0.0.1:8080/completion' else 'brain.enabled/brain.url not as BRAIN_ENABLED')" \
 && python3 -c "import sys; from aaltonomous.baselines.classical.config import BAKED_OVERLAY, resolve_overlay; \
sys.exit(0 if resolve_overlay() == BAKED_OVERLAY else 'baked overlay not picked up')"

EXPOSE 8000
ENTRYPOINT ["/opt/brain/entrypoint.sh"]
CMD ["python3", "-m", "aaltonomous.baselines.classical.policy_server"]
