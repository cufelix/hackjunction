+def _draw(rng, spec, default=0.0):
+    """scalar | [lo, hi] (uniform) | {mean, std} (normal, clipped to +-3 std) | {lo, hi}."""
+    if spec is None:
+        return float(default)
+    if isinstance(spec, dict):
+        if "std" in spec:
+            m, sd = float(spec.get("mean", 0.0)), float(spec["std"])
+            return float(np.clip(rng.normal(m, sd), m - 3 * sd, m + 3 * sd)) if sd > 0 else m
+        return _u(rng, [spec["lo"], spec["hi"]])
+    return _u(rng, spec, default)
+
+
+def _sym(v):
+    return [-abs(v), abs(v)] if isinstance(v, (int, float)) else v
