+            "wall_xlo": ((cx - ox / 2 + t / 2 - 0.001, cy, z), (t, oy + 0.002, TAPE_H)),
+            "wall_xhi": ((cx + ox / 2 - t / 2 + 0.001, cy, z), (t, oy + 0.002, TAPE_H)),
+            "wall_ylo": ((cx, cy - oy / 2 + t / 2 - 0.001, z), (ox - 2 * t, t, TAPE_H)),
+            "wall_yhi": ((cx, cy + oy / 2 - t / 2 + 0.001, z), (ox - 2 * t, t, TAPE_H)),
+        }
+        for part, (c, sz) in parts.items():
+            out[f"tape_{name}_{part}"] = _visual_box(f"Tape_{name}_{part}", SC.mat_to_pelvis(c), (sz[1], sz[0], sz[2]), rgb)
