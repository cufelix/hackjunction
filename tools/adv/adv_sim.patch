+def sample_adv(A, seed, bin_names=()):
+    """`adv:` profile section -> per-episode params (own seed stream, so existing DR draws are unchanged).
+    Camera pose is relative to calibration.yaml: T' = T @ Rx(pitch) @ Ry(yaw), translation + cam_xyz_cm in the
+    pelvis frame (same convention as tools/pitch_fit.py). Bins: pelvis +x shift, common + per-bin jitter."""
+    if not A:
+        return None
+    ss = np.random.SeedSequence([int(seed) if seed is not None else 0, 0xAD7])
+    r = np.random.default_rng(ss)
+    xyz = A.get("cam_xyz_cm") or [0, 0, 0]
+    xyz = [xyz] * 3 if isinstance(xyz, (int, float)) else list(xyz)      # cm; scalar a = +-a on every axis
+    jit = float(A.get("bin_dx_jitter_cm") or 0.0)
+    common = _draw(r, A.get("bin_dx_cm"), 0.0)
+    img = {
+        "exposure_gain": float(2.0 ** _draw(r, A.get("exposure_ev"), 0.0)),
+        "wb_gain": [float(1.0 + _draw(r, A.get("wb_jitter"), 0.0)) for _ in range(3)] if A.get("wb_jitter") else [1.0] * 3,
+        "gamma": _draw(r, A.get("gamma"), 1.0),
+        "depth_hole_blob_frac": float(_draw(r, A.get("depth_hole_blob_frac"), 0.0)),
+        "depth_hole_near_boost": float(A.get("depth_hole_near_boost") or 1.0),
+        "depth_hole_blob_seed": int(r.integers(2 ** 31)),
+    }
+    if A.get("depth_hole_frac") is not None:          # explicit in the profile -> overrides the legacy camera: section
+        img["depth_hole_frac"] = float(_draw(r, A["depth_hole_frac"], 0.0))
+    if A.get("depth_noise_mm") is not None:
+        img["depth_noise_mm"] = float(_draw(r, A["depth_noise_mm"], 0.0))
+    out = {
+        "image": img,
+        "cam": {"pitch_deg": _draw(r, A.get("cam_pitch_deg"), 0.0), "yaw_deg": _draw(r, A.get("cam_yaw_deg"), 0.0),
+                "xyz_m": [_draw(r, _sym(v)) / 100.0 for v in xyz]},
+        "bin_dx_m": {b: (common + float(r.uniform(-jit, jit)) if jit else common) / 100.0 for b in bin_names},
+        "render_colors": A.get("render_colors"), "bin_rgb": A.get("bin_rgb"), "tape_rgb": A.get("tape_rgb"),
