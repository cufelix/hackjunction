+def _blob_mask(shape, frac, seed):
+    """Per-episode static smooth blobs covering ~frac of the image (True = hole)."""
+    import cv2
+    h, w = shape
+    f = np.random.default_rng(seed).uniform(size=(max(h // 40, 3), max(w // 40, 3))).astype(np.float32)
+    f = cv2.resize(f, (w, h), interpolation=cv2.INTER_CUBIC)
+    return f <= np.quantile(f, min(max(frac, 0.0), 1.0))
+
