+def show_camera_cfg():
+    """AALTO_SHOWCAM=1: third-person 1280x720 RTX camera (world-fixed, side-front of the robot + counter) for demo video."""
+    eye = PELVIS_W + np.array([float(v) for v in os.environ.get("AALTO_SHOWCAM_EYE", "1.05,-0.80,0.30").split(",")])
+    tgt = PELVIS_W + np.array([float(v) for v in os.environ.get("AALTO_SHOWCAM_TGT", "0.30,0.0,-0.20").split(",")])
+    fwd = (tgt - eye) / np.linalg.norm(tgt - eye)
+    left = np.cross([0.0, 0.0, 1.0], fwd); left /= np.linalg.norm(left)
+    up = np.cross(fwd, left)
+    R = np.stack([fwd, left, up], axis=1)   # world convention: camera +x forward, +z up
+    return CameraCfg(
+        prim_path="/World/ShowCam", update_period=1.0 / 30, height=720, width=1280, data_types=["rgb"],
+        spawn=sim_utils.PinholeCameraCfg(focal_length=18.0, horizontal_aperture=20.955, clipping_range=(0.05, 20.0)),
+        offset=CameraCfg.OffsetCfg(pos=tuple(float(v) for v in eye), rot=rotmat_to_quat_xyzw(R), convention="world"),
+    )
+
