+        tab = np.asarray(table, float)
+        if tab.shape != (12,):
+            raise ValueError("prism offset table needs 12 values (0..110 deg, step 10)")
+        xs = np.r_[np.arange(0.0, 120.0, 10.0), 120.0]
+        return float(np.interp(float(rel_deg) % 120.0, xs, np.r_[tab, tab[0]]))
+
+    def _prism_shift(self, det, side, p, arm_q):
