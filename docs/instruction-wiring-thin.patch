diff --git a/aaltonomous/baselines/classical/policy.py b/aaltonomous/baselines/classical/policy.py
index 5c6f94f..9473d43 100644
--- a/aaltonomous/baselines/classical/policy.py
+++ b/aaltonomous/baselines/classical/policy.py
@@ -66,11 +66,31 @@ class ClassicalPolicy:
         self.reset()
 
     # ------------------------------------------------------------------ API
+    def _instruction_mapping(self, info):
+        """Instruction text -> mapping for `scene.resolve_bin`, or None to fall back to FIXED.
+
+        Off unless `instruction.resolve` is true in config.yaml, so the reference measurement is
+        unchanged by default. NEVER raises: reset() is under a 1.0 s watchdog (safety.py:69) and an
+        exception here would end the episode as a BAD_END, which is worse than any wrong mapping.
+        The resolver is pure stdlib and measured at ~0.13 ms per sentence.
+        """
+        try:                                        # the WHOLE body, not just the resolve call
+            if not (self.cfg.get("instruction") or {}).get("resolve", False):
+                return None
+            text = (info or {}).get("instruction") or ""
+            if not text:
+                return None
+            from .instruction import resolve
+            return resolve(text) or None
+        except Exception as e:                      # a parse bug must not cost the whole episode
+            self.log(f"instruction resolve failed ({e}), using FIXED_MAPPING")
+            return None
+
     def reset(self, info=None):
         if isinstance(info, str):
             info = {"instruction": info}
         info = info or {}
-        self.mapping = info.get("mapping") or dict(FIXED_MAPPING)
+        self.mapping = info.get("mapping") or self._instruction_mapping(info) or dict(FIXED_MAPPING)
         self.planner.mapping = self.mapping
         self.time_limit = info.get("time_limit", self.time_limit)
         self.state = "init"
diff --git a/aaltonomous/baselines/classical/test_instruction_wiring.py b/aaltonomous/baselines/classical/test_instruction_wiring.py
new file mode 100644
index 0000000..5b293f5
--- /dev/null
+++ b/aaltonomous/baselines/classical/test_instruction_wiring.py
@@ -0,0 +1,76 @@
+"""Does the wiring in policy.py actually reach the resolver? CPU only, no sim, no URDF.
+
+Run before spending GPU time:  python3 -m pytest aaltonomous/baselines/classical/test_instruction_wiring.py
+
+`ClassicalPolicy.__init__` loads a URDF and the IK solver, so instantiating it here is not an
+option. `_instruction_mapping` only ever touches `self.cfg` and `self.log`, so it is called
+unbound on a stub -- which exercises the real method body, including the relative import of
+`.instruction` that would silently fall back to FIXED_MAPPING if the module were missing from
+the image.
+"""
+from __future__ import annotations
+
+import unittest
+
+from aaltonomous.baselines.classical.policy import ClassicalPolicy
+from aaltonomous.interface.tasks import FIXED_MAPPING
+
+LANGUAGE = ("Sort the objects: blue into left, red into center, yellow into right.")
+
+
+class Stub:
+    """Just enough of a policy for `_instruction_mapping`."""
+
+    def __init__(self, resolve):
+        self.cfg = {"instruction": {"resolve": resolve}}
+        self.logged = []
+        self.log = self.logged.append
+
+    mapping = staticmethod(ClassicalPolicy._instruction_mapping)
+
+
+def call(resolve, info):
+    s = Stub(resolve)
+    return ClassicalPolicy._instruction_mapping(s, info), s.logged
+
+
+class TestWiring(unittest.TestCase):
+    def test_flag_off_is_byte_for_byte_the_old_behaviour(self):
+        """The step-0 reference run must not move: off -> None -> `or dict(FIXED_MAPPING)`."""
+        got, logged = call(False, {"instruction": LANGUAGE})
+        self.assertIsNone(got)
+        self.assertEqual(logged, [])
+
+    def test_flag_on_resolves_the_sentence(self):
+        got, _ = call(True, {"instruction": LANGUAGE})
+        self.assertEqual(got, {"blue": "left", "red": "center", "yellow": "right"})
+        self.assertNotEqual(got, FIXED_MAPPING, "a language episode must not sort by FIXED")
+
+    def test_no_text_no_mapping(self):
+        for info in ({}, None, {"instruction": ""}, {"instruction": None}):
+            self.assertIsNone(call(True, info)[0], info)
+
+    def test_garbage_still_yields_a_mapping_so_the_robot_has_somewhere_to_put_things(self):
+        got, _ = call(True, {"instruction": "do the needful"})
+        self.assertTrue(got and all(v in ("left", "center", "right") for v in got.values()), got)
+
+    def test_a_resolver_that_raises_costs_nothing(self):
+        """reset() is under a 1.0 s watchdog; an exception here would be a BAD_END."""
+        class Boom(Stub):
+            pass
+
+        s = Boom(True)
+        s.cfg = {"instruction": {"resolve": True}}
+
+        # A dict subclass that explodes on the .get("instruction") the method does next. It has to
+        # be NON-EMPTY: `info or {}` swaps an empty dict for a plain one, which never raises.
+        class Evil(dict):
+            def get(self, *a, **k):
+                raise RuntimeError("parser bug")
+
+        self.assertIsNone(ClassicalPolicy._instruction_mapping(s, Evil(instruction="x")))
+        self.assertTrue(any("instruction resolve failed" in m for m in s.logged), s.logged)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
